+                style: TextStyle(
+                  fontSize: 14,
+                  color: Colors.white70,
+                ),
+              ),
+            ],
+          ),
+        ),
+      );
+    }
+
+    // Once initialized, show the login screen
+    return const LoginScreen();
+  }
+}
