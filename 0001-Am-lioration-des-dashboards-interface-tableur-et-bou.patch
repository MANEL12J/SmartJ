+
+  void _stopTimer() {
+    _timer?.cancel();
+    _stopwatch.stop();
+    setState(() {
+      _isRunning = false;
+    });
+  }
+
+  void _resetTimer() {
+    _timer?.cancel();
+    _stopwatch.stop();
