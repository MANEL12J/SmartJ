--- /dev/null
+++ b/firestore.rules
@@ -0,0 +1,10 @@
+rules_version = '2';
+service cloud.firestore {
+  match /databases/{database}/documents {
+    // Allow all read/write operations for now (for development)
+    // In production, you should implement proper security rules
+    match /{document=**} {
+      allow read, write: if true;
+    }
+  }
+}
